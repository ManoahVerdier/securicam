# =============================================================================
# Securicam — production env (copy to .env.prod and fill in real secrets)
# =============================================================================

# --- Public deployment ------------------------------------------------------
PUBLIC_HOST=securicam.verdier-developpement.fr
PUBLIC_IP=203.0.113.42                 # <-- VPS public IPv4 (used by coturn)

# --- Laravel ---------------------------------------------------------------
APP_NAME=Securicam
APP_ENV=production
APP_DEBUG=false
APP_URL=https://securicam.verdier-developpement.fr
APP_KEY=                                # <-- generate with: php artisan key:generate --show

LOG_LEVEL=warning

# --- Database --------------------------------------------------------------
DB_DATABASE=securicam
DB_USERNAME=securicam
DB_PASSWORD=replace_with_strong_password
DB_ROOT_PASSWORD=replace_with_root_password

# --- Sanctum / sessions ----------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=securicam.verdier-developpement.fr
SESSION_DOMAIN=securicam.verdier-developpement.fr
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=redis

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://securicam.verdier-developpement.fr

# --- Reverb (WebSocket) ----------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=securicam
REVERB_APP_KEY=securicam-app-key
REVERB_APP_SECRET=replace_with_random_secret
REVERB_HOST=reverb                       # internal docker hostname (server-side)
REVERB_PORT=8081                         # internal port
REVERB_SCHEME=http
# Public values (used by frontend/Android, served via /api/config or hardcoded):
REVERB_HOST_PUBLIC=securicam.verdier-developpement.fr
REVERB_PORT_PUBLIC=443
REVERB_SCHEME_PUBLIC=https

# --- TURN (coturn) ---------------------------------------------------------
TURN_HOST=securicam.verdier-developpement.fr
TURN_USER=securicam
TURN_PASSWORD=replace_with_long_random_password
