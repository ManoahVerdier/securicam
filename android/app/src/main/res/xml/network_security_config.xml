<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Production: HTTPS-only. Cleartext is disabled globally.
        For local LAN debugging, switch to debug builds that override this file
        via src/debug/res/xml/network_security_config.xml (not committed).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
