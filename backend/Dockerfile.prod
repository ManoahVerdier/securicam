FROM php:8.3-fpm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libsqlite3-dev \
    zip \
    unzip \
    && docker-php-ext-install pdo_sqlite mbstring exif pcntl bcmath gd \
    && rm -rf /var/lib/apt/lists/*

# Install Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# OPcache — improves throughput on repeated PHP-FPM requests
RUN docker-php-ext-install opcache
RUN { \
        echo "opcache.enable=1"; \
        echo "opcache.memory_consumption=128"; \
        echo "opcache.interned_strings_buffer=8"; \
        echo "opcache.max_accelerated_files=10000"; \
        echo "opcache.revalidate_freq=0"; \
        echo "opcache.validate_timestamps=0"; \
        echo "opcache.save_comments=1"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# Upload limits for video captures (must be >= Laravel's 100 MB validator cap)
RUN { \
        echo "upload_max_filesize=200M"; \
        echo "post_max_size=200M"; \
        echo "memory_limit=256M"; \
        echo "max_execution_time=120"; \
    } > /usr/local/etc/php/conf.d/securicam-uploads.ini

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Copy composer manifests first so dependency layer is cached separately
COPY composer.json composer.lock /var/www/
RUN composer install --no-interaction --no-dev --prefer-dist --no-scripts --no-autoloader

# Copy application source
COPY . /var/www

# Optimised autoloader (no dev classes)
RUN composer dump-autoload --no-dev --optimize --no-scripts

# Permissions
RUN chown -R www-data:www-data /var/www \
    && chmod -R 755 /var/www/storage

EXPOSE 9000
CMD ["php-fpm"]
